{
  "name": "evaltrack-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web dashboard for evaltrack: browse, diff and inspect eval runs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.report.config.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  }
}
